<turbo-frame id="plants" data-controller="plants-loader">
  <div class="special-plant-garden mystic-card mb-5">
    <div class="special-plant-header d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h2 class="mb-1">
          <i class="bi bi-flower3"></i> Ton petit jardin 🌿
        </h2>
        <p class="text-muted mb-0">
          Envoie moi une photo de toutes tes plantes ma belle, je devine laquelle c'est et crée sa fiche d'entretien pour toi.<br>
          Il y a pas moyen que tu resortes sans l'appart et le balcon le plus vert de CliCli !
        </p>
      </div>
      <div class="d-flex w-100 justify-content-center justify-content-sm-end">
        <%= form_with model: @plant,
                      url: plants_path,
                      html: { multipart: true,
                              class: "d-flex flex-column flex-sm-row align-items-center align-items-sm-center justify-content-center gap-2",
                              data: { controller: "file-input" } } do |f| %>
          <div class="plant-file-input-wrapper">
            <%= f.file_field :photo, accept: "image/*", capture: "environment", class: "plant-file-input", required: true, data: { action: "change->file-input#updateLabel", file_input_target: "input" } %>
            <label for="<%= f.field_id(:photo) %>" class="plant-file-label">
              <i class="bi bi-camera-fill"></i>
              <span class="plant-file-label-text" data-file-input-target="labelText">Choisir une photo</span>
              <span class="plant-file-name" data-file-input-target="fileName"></span>
            </label>
          </div>
          <div class="text-center text-sm-end">
            <%= f.submit "Ajouter une plante", class: "btn btn-mystic" %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @plants.any? %>
      <div class="row mt-4">
        <% @plants.each do |plant| %>
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="mystic-card h-100 plant-card">
              <div class="plant-card-inner d-flex flex-column h-100">
                <% if plant.photo.attached? %>
                  <div class="plant-photo-container mb-3 text-center">
                    <%= cl_image_tag plant.photo.blob.key,
                      transformation: [
                        { width: 400, height: 400, crop: :fill, gravity: :auto, fetch_format: :auto, quality: "auto" }
                      ],
                      class: "img-fluid rounded",
                      alt: plant.name.presence || "Photo de plante" %>
                  </div>
                <% end %>

                <h3 class="mb-2"><i class="bi bi-flower1"></i> <%= plant.name %></h3>
                <% if plant.description.present? %>
                  <p class="text-muted mb-3"><%= plant.description %></p>
                <% end %>

                <ul class="list-unstyled small mb-0">
                  <% if plant.sun_need.present? %>
                    <li><strong>Soleil :</strong> <%= plant.sun_need %></li>
                  <% end %>
                  <% if plant.water_need.present? %>
                    <li><strong>Eau :</strong> <%= plant.water_need %></li>
                  <% end %>
                  <% if plant.soil_need.present? %>
                    <li><strong>Sol :</strong> <%= plant.soil_need %></li>
                  <% end %>
                  <% if plant.wind_need.present? %>
                    <li><strong>Vent :</strong> <%= plant.wind_need %></li>
                  <% end %>
                  <% if plant.other_needs.present? %>
                    <li><strong>Autres conseils :</strong> <%= plant.other_needs %></li>
                  <% end %>
                </ul>

                <div class="mt-3 text-end plant-card-actions mt-auto">
                  <%= button_to plant_path(plant), method: :delete, class: "btn btn-sm btn-danger", data: { action: "click->confirm#open", confirm_title: "Supprimer cette plante ?", confirm_message: "Es-tu sûr(e) de vouloir supprimer #{plant.name} de ton jardin ?\n\nCette action est irréversible.", confirm_text: "Oui, supprimer", cancel_text: "Annuler", confirm_type: "danger" } do %>
                    <i class="bi bi-trash"></i> Supprimer
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted mt-3 mb-0">
        Tu n'as pas encore ajouté de plante. Commence par envoyer une première photo 🌱
      </p>
    <% end %>
  </div>

  <!-- Loader Fullscreen pour analyse de plante -->
  <div class="loading-fullscreen" data-plants-loader-target="overlay" style="display: none;">
    <div class="loading-fullscreen-content">
      <div class="mystic-spinner-large">
        <div class="spinner-ring"></div>
        <div class="spinner-ring"></div>
        <div class="spinner-ring"></div>
        <div class="spinner-moon">🌿</div>
      </div>
      <h2 class="loading-title">Analyse de ta plante en cours...</h2>
      <p class="loading-text">
        Laisse moi identifier ta plante et générer sa fiche d'entretien<br>
        <small>Tu pourras bientôt l'ajouter à ton jardin virtuel ma bewwllle</small>
      </p>
      <div class="loading-dots">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </div>
</turbo-frame>
