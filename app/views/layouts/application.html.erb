<!DOCTYPE html>
<html>
  <head>
    <title>DreamCatcher - Interprétation Mystique des Rêves</title>
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=no">
<meta name="mobile-web-app-capable" content="yes">
<%= tag.link rel: "manifest", href: webmanifest_path(format: :json) %>
<%= tag.link rel: "icon", href: "/icon-192x192-dark.png", type: "image/png" %>
<%= tag.link rel: "apple-touch-icon", href: "/apple-touch-icon.png" %>

<%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo-dream.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="mystic-body <%= 'special-theme' if special_user? %><%= ' home-page' if controller_name == 'home' && action_name == 'index' %>" data-controller="confirm pwa-install">
    <nav class="navbar navbar-expand-lg navbar-dark mystic-nav">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand mystic-brand" do %>
          <%= image_tag "logo-dream.png", class: "navbar-logo", alt: "DreamCatcher" %> DreamCatcher
        <% end %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <% if user_signed_in? %>
              <li class="nav-item">
                <%= link_to "Accueil", root_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Mes Rêves", dreams_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Analyse Globale", global_analyses_path, class: "nav-link" %>
              </li>
              <% if special_user? %>
                <li class="nav-item">
                  <%= link_to special_page_path, class: "nav-link" do %>
                    <i class="bi bi-stars"></i> Pour toi
                  <% end %>
                </li>
              <% end %>
              <li class="nav-item dropdown mystic-dropdown-hover">
                <a class="nav-link" href="<%= dashboard_path %>" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="bi bi-person-circle"></i> <%= current_user.first_name.presence || current_user.email.split('@').first %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li><%= link_to "Mon Profil", dashboard_path, class: "dropdown-item" %></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><%= link_to "Déconnexion", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item" %></li>
                </ul>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "Connexion", new_user_session_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Inscription", new_user_registration_path, class: "nav-link" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="alert alert-info alert-dismissible fade show mystic-alert" role="alert"
           data-controller="alert" data-alert-delay-value="4000">
        <%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <% if alert %>
      <div class="alert alert-warning alert-dismissible fade show mystic-alert" role="alert"
           data-controller="alert" data-alert-delay-value="5000">
        <%= alert %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <main class="mystic-main <%= content_for?(:main_class) ? yield(:main_class) : '' %>">
      <%= yield %>
    </main>

    <!-- Modale de confirmation -->
    <%= render 'shared/confirm_modal' %>

    <% if special_user? %>
      <footer class="special-message text-center py-3">
        <div class="container">
          <p>✨ &copy; 2025 DreamCatcher - Made for Lisa 💅☀️ with ❤️ </p>
        </div>
      </footer>
    <% else %>
       <footer class="mystic-footer text-center py-3">
        <div class="container">
          <p>&copy; 2025 DreamCatcher — <em>Plongez dans les mystères de vos rêves</em></p>
        </div>
      </footer>
    <% end %>

    <!-- PWA Install Banner (Chrome, Edge, Samsung) -->
    <div class="pwa-install-banner" data-pwa-install-target="banner" style="display: none;">
      <div class="pwa-install-content">
        <i class="bi bi-download"></i>
        <span>Installer DreamCatcher sur votre appareil</span>
      </div>
      <div class="pwa-install-actions">
        <button class="btn btn-mystic btn-sm" data-action="click->pwa-install#install">Installer</button>
        <button class="btn btn-link btn-sm" data-action="click->pwa-install#dismiss">Plus tard</button>
      </div>
    </div>

    <!-- iOS Safari Instructions -->
    <div class="pwa-install-banner pwa-ios" data-pwa-install-target="iosInstructions" style="display: none;">
      <div class="pwa-install-content">
        <i class="bi bi-phone"></i>
        <span>Installer l'app : appuyez sur <i class="bi bi-box-arrow-up"></i> puis "Sur l'écran d'accueil"</span>
      </div>
      <button class="btn btn-link btn-sm" data-action="click->pwa-install#dismiss">Fermer</button>
    </div>
  </body>
</html>
